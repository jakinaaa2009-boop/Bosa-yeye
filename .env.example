MONGODB_URI=mongodb://localhost:27017/yeye-lucky-draw
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Cloudflare R2 — use account ID only (32-char hex), NOT the full endpoint URL
R2_ACCOUNT_ID=your_32_character_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Local-only CallApiAdmin test panel (development only — returns 404 in production)
ENABLE_CALLAPIADMIN=true
CALLAPIADMIN_USERNAME=killua
CALLAPIADMIN_PASSWORD_HASH=
CALLAPIADMIN_SESSION_SECRET=local-dev-session-secret-change-me
