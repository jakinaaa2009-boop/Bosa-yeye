MONGODB_URI=mongodb://localhost:27017/yeye-lucky-draw
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Cloudflare R2 — use account ID only (32-char hex), NOT the full endpoint URL
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# CallApiAdmin — set ENABLE_CALLAPIADMIN=false to disable
ENABLE_CALLAPIADMIN=false
CALLAPIADMIN_USERNAME=
CALLAPIADMIN_PASSWORD_HASH=
CALLAPIADMIN_PASSWORD_HASH_B64=
CALLAPIADMIN_SESSION_SECRET=
